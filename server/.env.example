# =============================================================
# LegalSahayak – Environment Variables
# Copy this file to .env and fill in real values before starting
# =============================================================

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── MongoDB ──────────────────────────────────────────────────
# Atlas URI with Vector Search enabled
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxx.mongodb.net/legalsahayak?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change_me_access_secret_at_least_64_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption (AES-256-GCM) ────────────────────────────────
# 32-byte hex key: openssl rand -hex 32
ENCRYPTION_KEY=change_me_32_byte_hex_key_here_00000000000000000000000000000000

# ── AI Provider ──────────────────────────────────────────────
# Supported: "gemini" | "openai"
AI_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-1.5-flash

# OpenAI (fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Razorpay ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Platform Settings ────────────────────────────────────────
# Commission percentage (default 15%)
PLATFORM_COMMISSION_PERCENT=15
# GST rate on platform fee (default 18%)
GST_RATE_PERCENT=18
# Minimum consultation fee in paise (default ₹300 = 30000 paise)
MIN_CONSULTATION_FEE_PAISE=30000
# Document retention in days
DOCUMENT_RETENTION_DAYS=30

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="LegalSahayak <noreply@legalsahayak.in>"

# ── SMS (optional, leave blank to skip SMS OTP) ──────────────
# Provider: "twilio" | ""
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Admin Seed ───────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@legalsahayak.in
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=Platform Admin

# ── Upload ───────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

# ── Vector Search ────────────────────────────────────────────
# Name of the Atlas Search index on LegalChunk.embedding
ATLAS_VECTOR_INDEX=vector_index
VECTOR_TOP_K=6

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
